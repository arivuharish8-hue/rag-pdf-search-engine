# Get these values from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the secret key on this Flask server only. Never expose it in browser code.
SUPABASE_SECRET_KEY=your-secret-key
# Create this bucket in Supabase Storage before running the app.
SUPABASE_BUCKET=pdfs
FLASK_SECRET_KEY=replace-with-a-long-random-string
# Create an API key in Google AI Studio and keep it server-side only.
GEMINI_API_KEY=your-gemini-api-key

# RabbitMQ broker (Celery). Default vhost "//".
# Local dev:
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
# Inside docker-compose the host is the "rabbitmq" service, set automatically.
#RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Second-stage reranker (local cross-encoder, no extra pip packages).
# The model is pre-cached in the Docker image and loaded lazily on first use.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
RERANK_TOP_K=5
