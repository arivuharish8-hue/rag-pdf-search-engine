# Get these values from your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the secret key on this Flask server only. Never expose it in browser code.
SUPABASE_SECRET_KEY=your-secret-key
# Create this bucket in Supabase Storage before running the app.
SUPABASE_BUCKET=pdfs
FLASK_SECRET_KEY=replace-with-a-long-random-string
# Create an API key in Google AI Studio and keep it server-side only.
GEMINI_API_KEY=your-gemini-api-key
